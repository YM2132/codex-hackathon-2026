{
  "manifest_version": 3,
  "name": "Pawse — YouTube family mode",
  "version": "0.1.0",
  "description": "Pawse helps parents pause and review YouTube videos for their family.",
  "icons": {
    "16": "assets/icons/pawse-16.png",
    "32": "assets/icons/pawse-32.png",
    "48": "assets/icons/pawse-48.png",
    "128": "assets/icons/pawse-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Pawse family mode",
    "default_icon": {
      "16": "assets/icons/pawse-16.png",
      "32": "assets/icons/pawse-32.png",
      "48": "assets/icons/pawse-48.png",
      "128": "assets/icons/pawse-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/pawse-idle-cutout.png",
        "assets/pawse-thinking-cutout.png",
        "assets/pawse-greeting-cutout.png",
        "assets/pawse-pause-cutout.png"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Pawse — family mode for kids' video sites",
  "version": "0.4.0",
  "description": "Pawse checks buffered video frames ahead of playback with OpenAI Decisions on YouTube, YouTube Kids, TikTok, Instagram, X, Reddit, Snapchat and Dailymotion.",
  "icons": {
    "16": "assets/icons/pawse-16.png",
    "32": "assets/icons/pawse-32.png",
    "48": "assets/icons/pawse-48.png",
    "128": "assets/icons/pawse-128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Pawse family mode",
    "default_icon": {
      "16": "assets/icons/pawse-16.png",
      "32": "assets/icons/pawse-32.png",
      "48": "assets/icons/pawse-48.png",
      "128": "assets/icons/pawse-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtubekids.com/*",
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://www.reddit.com/*",
        "https://www.snapchat.com/*"
      ],
      "js": [
        "lookahead/extension/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtubekids.com/*",
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://www.reddit.com/*",
        "https://www.snapchat.com/*"
      ],
      "js": [
        "sites.js",
        "guard.js",
        "engine.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://geo.dailymotion.com/*"
      ],
      "js": [
        "lookahead/extension/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://geo.dailymotion.com/*"
      ],
      "js": [
        "sites.js",
        "guard.js",
        "engine.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/pawse-idle-cutout.png",
        "assets/pawse-thinking-cutout.png",
        "assets/pawse-greeting-cutout.png",
        "assets/pawse-pause-cutout.png"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtubekids.com/*",
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://www.reddit.com/*",
        "https://www.snapchat.com/*",
        "https://geo.dailymotion.com/*"
      ]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Sprout — YouTube family mode",
  "version": "0.1.0",
  "description": "A parent-controlled pause and review flow for YouTube videos.",
  "icons": {
    "16": "assets/icons/sprout-16.png",
    "32": "assets/icons/sprout-32.png",
    "48": "assets/icons/sprout-48.png",
    "128": "assets/icons/sprout-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Sprout family mode",
    "default_icon": {
      "16": "assets/icons/sprout-16.png",
      "32": "assets/icons/sprout-32.png",
      "48": "assets/icons/sprout-48.png",
      "128": "assets/icons/sprout-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/sprout-mascot-512.png"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
